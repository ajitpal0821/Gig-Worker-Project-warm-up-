# Saathi Backend Environment Configuration Template
GEMINI_API_KEY=your_gemini_api_key_here
# AI Model Tier: 'low' (fast/lite), 'medium' (balanced/default), 'high' (deep reasoning)
GEMINI_MODEL=medium
GEMINI_BACKUP_MODEL=low
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
COOKIE_SAMESITE=lax
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/saathi?retryWrites=true&w=majority
