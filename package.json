{
  "name": "saathi-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Saathi — Multilingual AI Assistant for Gig and Informal Workers in India",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node backend/src/index.js",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "test": "node run-tests.js",
    "test:backend": "node run-tests.js",
    "test:e2e": "playwright test --project=chromium",
    "test:all": "node run-tests.js && playwright test --project=chromium",
    "generate:pdf": "node generate-pdf.js",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  },
  "keywords": [
    "gig-workers",
    "informal-economy",
    "gemini-ai",
    "search-grounding",
    "angular",
    "india",
    "eshram"
  ],
  "author": "Prompt Wars Hackathon Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
